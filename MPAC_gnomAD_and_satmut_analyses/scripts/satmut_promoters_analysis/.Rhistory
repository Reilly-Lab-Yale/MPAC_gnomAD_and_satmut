# load genomic ranges
satmut_promoters_final_gr <- as_tibble(fread("../../data/gencode_filtered_regions/gencode.v44.protein.coding.1kb.promoters.autosomes.v2.bed.gz"))
names(satmut_promoters_final_gr) <- c("seqnames", "start", "end", "gene_name", "score", "strand", "id")
satmut_promoters_final_gr <- satmut_promoters_final_gr %>% mutate(start = start + 1)  # 0 to 1-index)
satmut_promoters_final_gr <- extend_granges(GRanges(satmut_promoters_final_gr), -750+50, 100+50)  # 250 bp promoter
satmut_promoters_final_gr
width(satmut_promoters_final_gr)
knitr::opts_chunk$set(echo = TRUE)
# load libraries
library(Cairo)
library(tidyverse)
library(data.table)
library(viridis)
library(GGally)
library(ggrepel)
library(ggpubr)
save_path <- "../../results/satmut_promoters_analysis/satmut_promoters_overall_promoters/"
dir.create(save_path, showWarnings = FALSE, recursive = TRUE)
gene_class_map <- c(
clingen_hi = "Haploinsufficient",
autosomal_dominant = "Autosomal dominant",
autosomal_recessive = "Autosomal recessive",
depmap_essential = "DepMap essential",
mouse_essential = "Mouse essential",
oncokb_tumor_supressor = "Tumor supressor gene",
oncokb_oncogene = "Oncogene",
olfactory = "Olfactory"
)
satmut_promoters_gene_metadata <- as_tibble(fread("../../data/satmut_promoters_preprocess/satmut_promoters_gene_metadata/satmut_promoters_gene_metadata.txt.gz"))
satmut_promoters_pred_final_prom_level <- as_tibble(fread("../../data/satmut_promoters_preprocess/satmut_promoters_final_prom/satmut_promoters_final_prom_all.txt.gz"))
satmut_promoters_pred_final_prom_level <- satmut_promoters_pred_final_prom_level %>%
left_join(satmut_promoters_gene_metadata) %>%
filter(analysis_version %in% c("promoter_250bp", "shuffled_promoter_250bp"))
satmut_promoters_pred_final_prom_level <- satmut_promoters_pred_final_prom_level %>%
mutate(
correlation_mam241_vs_avgKHS_rho_padj_abs = p.adjust(correlation_mam241_vs_avgKHS_rho_pval_abs, method = "fdr"),
correlation_mam241_vs_avgKHS_rho_padj_pos = p.adjust(correlation_mam241_vs_avgKHS_rho_pval_pos, method = "fdr"),
correlation_mam241_vs_avgKHS_rho_padj_neg = p.adjust(correlation_mam241_vs_avgKHS_rho_pval_neg, method = "fdr"),
)
satmut_promoters_pred_final_prom_level_null <- satmut_promoters_pred_final_prom_level %>%
filter(analysis_version == "shuffled_promoter_250bp")
satmut_promoters_pred_final_prom_level_real <- satmut_promoters_pred_final_prom_level %>%
filter(analysis_version == "promoter_250bp")
threshold_abs <- satmut_promoters_pred_final_prom_level_null$correlation_mam241_vs_avgKHS_rho_est_abs %>% quantile(0.999, na.rm=T)
threshold_pos <- satmut_promoters_pred_final_prom_level_null$correlation_mam241_vs_avgKHS_rho_est_pos %>% quantile(0.999, na.rm=T)
threshold_neg <- satmut_promoters_pred_final_prom_level_null$correlation_mam241_vs_avgKHS_rho_est_neg %>% quantile(0.001, na.rm=T)
threshold_fdr <- 0.01
satmut_promoters_pred_final_prom_level <- satmut_promoters_pred_final_prom_level %>%
mutate(sig_pos_0.999_neg_0.001 =
ifelse(((correlation_mam241_vs_avgKHS_rho_padj_pos < threshold_fdr) & (correlation_mam241_vs_avgKHS_rho_est_pos > threshold_pos)) &
((correlation_mam241_vs_avgKHS_rho_padj_neg < threshold_fdr) & (correlation_mam241_vs_avgKHS_rho_est_neg < threshold_neg)), "both",
ifelse((correlation_mam241_vs_avgKHS_rho_padj_pos < threshold_fdr) & (correlation_mam241_vs_avgKHS_rho_est_pos > threshold_pos), "pos",
ifelse((correlation_mam241_vs_avgKHS_rho_padj_neg < threshold_fdr) & (correlation_mam241_vs_avgKHS_rho_est_neg < threshold_neg), "neg", "nonsig"))))
table(satmut_promoters_pred_final_prom_level_real$sig_pos_0.999_neg_0.001)
write_tsv(satmut_promoters_pred_final_prom_level, gzfile(paste0(save_path, "satmut_prom_prom_level_all.txt.gz")))
satmut_promoters_pred_final_prom_level_null <- satmut_promoters_pred_final_prom_level %>%
filter(analysis_version == "shuffled_promoter_250bp") %>%
filter(!is.na(correlation_mam241_vs_avgKHS_rho_est_pos) & !is.na(correlation_mam241_vs_avgKHS_rho_est_neg))
write_tsv(satmut_promoters_pred_final_prom_level_null, gzfile(paste0(save_path, "satmut_prom_prom_level_null.txt.gz")))
satmut_promoters_pred_final_prom_level_real <- satmut_promoters_pred_final_prom_level %>%
filter(analysis_version == "promoter_250bp") %>%
filter(!is.na(correlation_mam241_vs_avgKHS_rho_est_pos) & !is.na(correlation_mam241_vs_avgKHS_rho_est_neg))
write_tsv(satmut_promoters_pred_final_prom_level_real, gzfile(paste0(save_path, "satmut_prom_prom_level_real.txt.gz")))
# what percentage higher than ldlr
ldlr_neg <- filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$correlation_mam241_vs_avgKHS_rho_est_neg
prop_ldlr <- nrow(filter(satmut_promoters_pred_final_prom_level_real, correlation_mam241_vs_avgKHS_rho_est_neg < ldlr_neg))/nrow(satmut_promoters_pred_final_prom_level_real)
# what is the rho for ldlr, tnks2, and cc10
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$correlation_mam241_vs_avgKHS_rho_est_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$correlation_mam241_vs_avgKHS_rho_est_pos
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "TNKS2")$correlation_mam241_vs_avgKHS_rho_est_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "TNKS2")$correlation_mam241_vs_avgKHS_rho_est_pos
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "CCR10")$correlation_mam241_vs_avgKHS_rho_est_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "CCR10")$correlation_mam241_vs_avgKHS_rho_est_pos
# what is the p for ldlr, tnks2, and cc10
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$correlation_mam241_vs_avgKHS_rho_pval_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$correlation_mam241_vs_avgKHS_rho_pval_pos
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "TNKS2")$correlation_mam241_vs_avgKHS_rho_pval_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "TNKS2")$correlation_mam241_vs_avgKHS_rho_pval_pos
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "CCR10")$correlation_mam241_vs_avgKHS_rho_pval_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "CCR10")$correlation_mam241_vs_avgKHS_rho_pval_pos
# how many n for each of ldlr, tnks2, and ccr10
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$flag_correlation_mam241_vs_avgKHS_n_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "LDLR")$flag_correlation_mam241_vs_avgKHS_n_pos
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "TNKS2")$flag_correlation_mam241_vs_avgKHS_n_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "TNKS2")$flag_correlation_mam241_vs_avgKHS_n_pos
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "CCR10")$flag_correlation_mam241_vs_avgKHS_n_neg
filter(satmut_promoters_pred_final_prom_level_real, gene_name == "CCR10")$flag_correlation_mam241_vs_avgKHS_n_pos
p <- ggdensity(satmut_promoters_pred_final_prom_level,
x = "correlation_mam241_vs_avgKHS_rho_est_abs",
add = "none", rug = FALSE,
color = "analysis_version", fill = "analysis_version",
palette = c("#66c2a5", "grey80")
) +
geom_vline(
aes(xintercept = threshold_abs),
color = "#66c2a5",
linetype = "dashed"
) +
scale_color_manual(
values = c("promoter_250bp" = "#66c2a5", "shuffled_promoter_250bp" = "grey80"),
labels = c("promoter_250bp" = "Real", "shuffled_promoter_250bp" = "Shuffled"),
name = "Promoter"
) +
scale_fill_manual(
values = c("promoter_250bp" = "#66c2a5", "shuffled_promoter_250bp" = "grey80"),
labels = c("promoter_250bp" = "Real", "shuffled_promoter_250bp" = "Shuffled"),
name = "Promoter"
) +
labs(x = "Spearman's ρ", y = "Density") +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.major.y = element_line(color = "grey95"),
panel.grid.minor.y = element_line(color = "grey95"),
axis.line.y = element_blank()
)
d <- ggplot_build(p)$data[[1]] %>%
filter(colour == "#66c2a5")
p + geom_area(data = subset(d, x > threshold_abs), aes(x=x, y=y), fill="#66c2a5", alpha = 0.7)
ggsave(paste0(save_path, "satmut_prom_density_rho_abs.pdf"), scale=0.6, device = cairo_pdf)
p <- ggdensity(satmut_promoters_pred_final_prom_level,
x = "correlation_mam241_vs_avgKHS_rho_est_pos",
add = "none", rug = FALSE,
color = "analysis_version", fill = "analysis_version",
palette = c("#8da0cb", "grey80")
) +
geom_vline(
aes(xintercept = threshold_pos),
color = "#8da0cb",
linetype = "dashed"
) +
scale_color_manual(
values = c("promoter_250bp" = "#8da0cb", "shuffled_promoter_250bp" = "grey80"),
labels = c("promoter_250bp" = "Real", "shuffled_promoter_250bp" = "Shuffled"),
name = "Promoter"
) +
scale_fill_manual(
values = c("promoter_250bp" = "#8da0cb", "shuffled_promoter_250bp" = "grey80"),
labels = c("promoter_250bp" = "Real", "shuffled_promoter_250bp" = "Shuffled"),
name = "Promoter"
) +
labs(x = "Spearman's ρ", y = "Density") +
theme(
aspect.ratio = 1/5,
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.major.y = element_line(color = "grey95"),
panel.grid.minor.y = element_line(color = "grey95"),
axis.line.y = element_blank()
)
d <- ggplot_build(p)$data[[1]] %>%
filter(colour == "#8da0cb")
p + geom_area(data = subset(d, x > threshold_pos), aes(x=x, y=y), fill="#8da0cb", alpha = 0.7) +
theme(aspect.ratio=1/3)
ggsave(paste0(save_path, "satmut_prom_density_rho_pos.pdf"), scale=0.6, device = cairo_pdf)
p <- ggdensity(satmut_promoters_pred_final_prom_level,
x = "correlation_mam241_vs_avgKHS_rho_est_neg",
add = "none", rug = FALSE,
color = "analysis_version", fill = "analysis_version",
palette = c("#fc8d62", "grey80")
) +
geom_vline(
aes(xintercept = threshold_neg),
color = "#fc8d62",
linetype = "dashed"
) +
scale_color_manual(
values = c("promoter_250bp" = "#fc8d62", "shuffled_promoter_250bp" = "grey80"),
labels = c("promoter_250bp" = "Real", "shuffled_promoter_250bp" = "Shuffled"),
name = "Promoter"
) +
scale_fill_manual(
values = c("promoter_250bp" = "#fc8d62", "shuffled_promoter_250bp" = "grey80"),
labels = c("promoter_250bp" = "Real", "shuffled_promoter_250bp" = "Shuffled"),
name = "Promoter"
) +
labs(x = "Spearman's ρ", y = "Density") +
theme(
aspect.ratio = 1/5,
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.major.y = element_line(color = "grey95"),
panel.grid.minor.y = element_line(color = "grey95"),
axis.line.y = element_blank()
)
d <- ggplot_build(p)$data[[1]] %>%
filter(colour == "#fc8d62")
p + geom_area(data = subset(d, x < threshold_neg), aes(x=x, y=y), fill="#fc8d62", alpha = 0.7) +
theme(aspect.ratio=1/3)
ggsave(paste0(save_path, "satmut_prom_density_rho_neg.pdf"), scale=0.6, device = cairo_pdf)
top_select_genes <- satmut_promoters_pred_final_prom_level_real %>%
filter(sig_pos_0.999_neg_0.001 != "nonsig") %>%
mutate(correlation_mam241_vs_avgKHS_rho_est_pos_temp = ifelse(sig_pos_0.999_neg_0.001 == "neg", 0, correlation_mam241_vs_avgKHS_rho_est_pos)) %>%
mutate(correlation_mam241_vs_avgKHS_rho_est_neg_temp = ifelse(sig_pos_0.999_neg_0.001 == "pos", 0, correlation_mam241_vs_avgKHS_rho_est_neg)) %>%
arrange(desc(correlation_mam241_vs_avgKHS_rho_est_pos_temp - correlation_mam241_vs_avgKHS_rho_est_neg_temp)) %>%
dplyr::select(-correlation_mam241_vs_avgKHS_rho_est_pos_temp, -correlation_mam241_vs_avgKHS_rho_est_neg_temp) %>%
group_by(sig_pos_0.999_neg_0.001) %>%
slice(1:10) %>%
ungroup()
write_tsv(top_select_genes, paste0(save_path, "satmut_prom_scatter_rho_pos_vs_neg_top_select_genes.txt"))
top_ordered_genes <- satmut_promoters_pred_final_prom_level_real %>%
mutate(correlation_mam241_vs_avgKHS_rho_est_pos_temp = ifelse(sig_pos_0.999_neg_0.001 == "neg", 0, correlation_mam241_vs_avgKHS_rho_est_pos)) %>%
mutate(correlation_mam241_vs_avgKHS_rho_est_neg_temp = ifelse(sig_pos_0.999_neg_0.001 == "pos", 0, correlation_mam241_vs_avgKHS_rho_est_neg)) %>%
arrange(desc(correlation_mam241_vs_avgKHS_rho_est_pos_temp - correlation_mam241_vs_avgKHS_rho_est_neg_temp)) %>%
dplyr::select(-correlation_mam241_vs_avgKHS_rho_est_pos_temp, -correlation_mam241_vs_avgKHS_rho_est_neg_temp) %>%
group_by(sig_pos_0.999_neg_0.001) %>%
ungroup()
write_tsv(top_ordered_genes, gzfile(paste0(save_path, "satmut_prom_scatter_rho_pos_vs_neg_top_ordered_genes.txt.gz")))
# make gene lists
top_ordered_genes_both <- filter(top_ordered_genes, sig_pos_0.999_neg_0.001 == "both")$gene_name
top_ordered_genes_neg <- filter(top_ordered_genes, sig_pos_0.999_neg_0.001 == "neg")$gene_name
top_ordered_genes_pos <- filter(top_ordered_genes, sig_pos_0.999_neg_0.001 == "pos")$gene_name
top_ordered_genes_nonsig <- filter(top_ordered_genes, sig_pos_0.999_neg_0.001 == "nonsig")$gene_name
top_ordered_genes_background <- filter(top_ordered_genes, !is.na(correlation_mam241_vs_avgKHS_rho_est_pos) | !is.na(correlation_mam241_vs_avgKHS_rho_est_neg))$gene_name
# inspect gene lists
head(top_ordered_genes_both); length(top_ordered_genes_both)
head(top_ordered_genes_neg); length(top_ordered_genes_neg)
head(top_ordered_genes_pos); length(top_ordered_genes_pos)
head(top_ordered_genes_nonsig); length(top_ordered_genes_nonsig)
head(top_ordered_genes_background); length(top_ordered_genes_background)
# save gene lists
write(top_ordered_genes_both, paste0(save_path, "satmut_prom_genelist_both.txt"))
write(top_ordered_genes_neg, paste0(save_path, "satmut_prom_genelist_neg.txt"))
write(top_ordered_genes_pos, paste0(save_path, "satmut_prom_genelist_pos.txt"))
write(top_ordered_genes_nonsig, paste0(save_path, "satmut_prom_genelist_nonsig.txt"))
write(top_ordered_genes_background, paste0(save_path, "satmut_prom_genelist_background.txt"))
# highlight genes
genes_to_highlight <- c("LDLR", "TNKS2", "CCR10")
ggscatter(satmut_promoters_pred_final_prom_level_real,
x = "correlation_mam241_vs_avgKHS_rho_est_neg",
y = "correlation_mam241_vs_avgKHS_rho_est_pos",
color = "sig_pos_0.999_neg_0.001", fill = "sig_pos_0.999_neg_0.001",
palette = c("#984ea3", "#fc8d62", "#e3e1ef", "#8da0cb"),
alpha = 0.5
) +
xlab("Spearman's ρ (max(0, phyloP), allelic skew-)") +
ylab("Spearman's ρ (max(0, phyloP), allelic skew+)") +
theme(aspect.ratio = 1) +
geom_point(aes(
x = correlation_mam241_vs_avgKHS_rho_est_neg,
y = correlation_mam241_vs_avgKHS_rho_est_pos,
), color = "black", fill = "black",  alpha = 0.5,
data = filter(satmut_promoters_pred_final_prom_level_real, gene_name %in% genes_to_highlight)) +
geom_text_repel(aes(
x = correlation_mam241_vs_avgKHS_rho_est_neg,
y = correlation_mam241_vs_avgKHS_rho_est_pos,
label = gene_name,
),
data = filter(satmut_promoters_pred_final_prom_level_real, gene_name %in% genes_to_highlight),
max.overlaps = Inf)
ggsave(paste0(save_path, "satmut_prom_scatter_rho_pos_vs_neg.pdf"), device = cairo_pdf)
# highlight genes (top ranked)
genes_to_highlight <- c("LDLR", top_ordered_genes_neg[1:3], top_ordered_genes_both[1:3])
ggscatter(satmut_promoters_pred_final_prom_level_real,
x = "correlation_mam241_vs_avgKHS_rho_est_neg",
y = "correlation_mam241_vs_avgKHS_rho_est_pos",
color = "sig_pos_0.999_neg_0.001", fill = "sig_pos_0.999_neg_0.001",
palette = c("#984ea3", "#fc8d62", "#e3e1ef", "#8da0cb"),
alpha = 0.5
) +
xlab("Spearman's ρ (max(0, phyloP), allelic skew-)") +
ylab("Spearman's ρ (max(0, phyloP), allelic skew+)") +
theme(aspect.ratio = 1) +
geom_point(aes(
x = correlation_mam241_vs_avgKHS_rho_est_neg,
y = correlation_mam241_vs_avgKHS_rho_est_pos,
), color = "black", fill = "black",  alpha = 0.5,
data = filter(satmut_promoters_pred_final_prom_level_real, gene_name %in% genes_to_highlight)) +
geom_text_repel(aes(
x = correlation_mam241_vs_avgKHS_rho_est_neg,
y = correlation_mam241_vs_avgKHS_rho_est_pos,
label = gene_name,
),
data = filter(satmut_promoters_pred_final_prom_level_real, gene_name %in% genes_to_highlight),
max.overlaps = Inf)
ggsave(paste0(save_path, "satmut_prom_scatter_rho_pos_vs_neg_top_labeled.pdf"), device = cairo_pdf)
# readable labels for significance classes
sig_labels <- c(
"nonsig" = "Non-significant",
"neg"    = "Negative",
"pos"    = "Positive",
"both"   = "Both"
)
sig_palette <- c(
"Non-significant" = "#e3e1ef",
"Negative"        = "#fc8d62",
"Both"            = "#984ea3",
"Positive"        = "#8da0cb"
)
metrics <- list(
list(col = "s_het",   label = expression(italic(s)[het])),
list(col = "loeuf",   label = "LOEUF"),
list(col = "moeuf",   label = "MOEUF"),
list(col = "alphmis", label = "AlphaMissense"),
list(col = "tau_tissue", label = "Tissue specificity (τ)"),
list(col = "tau_celltype", label = "Cell-type specificity (τ)"),
list(col = "log_median_nTPM_tissue", label = "Median expression (tissue)"),
list(col = "log_median_nCPM_celltype", label = "Median expression (cell type)"),
list(col = "eds", label = "Enhancer domain score"),
list(col = "mean_frac_distal_count", label = "ABC distal fraction (count)"),
list(col = "mean_frac_distal_score", label = "ABC distal fraction (score)")
)
# collect test statistics across all metrics
violin_stats <- list()
for (m in metrics) {
df_plot <- satmut_promoters_pred_final_prom_level_real %>%
filter(!is.na(sig_pos_0.999_neg_0.001)) %>%
mutate(sig_class = factor(sig_labels[sig_pos_0.999_neg_0.001],
levels = names(sig_palette)))
p <- ggviolin(
df_plot,
x = "sig_class", y = m$col,
fill = "sig_class",
palette = sig_palette,
draw_quantiles = c(0.5)
) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.20))) +
geom_pwc(method = "wilcox_test", p.adjust.method = "BH",
label = "p.adj.format", hide.ns = TRUE, bracket.nudge.y = 0.15) +
theme(
axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
axis.line.x = element_blank(),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.major.y = element_line(color = "grey90"),
panel.grid.minor.y = element_blank(),
axis.line.y = element_blank(),
aspect.ratio = 1.6
) +
labs(y = m$label, x = "", fill = "")
if (m$col %in% c("s_het")) {
p <- p + scale_y_log10(expand = expansion(mult = c(0.05, 0.15)))
} else {
p <- p + scale_y_continuous(expand = expansion(mult = c(0.05, 0.15)))
}
print(p)
ggsave(paste0(save_path, "satmut_prom_violin_", m$col, ".pdf"), scale = 0.9, device = cairo_pdf)
# write per-metric summary table
summary_df <- df_plot %>%
group_by(sig_class) %>%
summarise(
n = sum(!is.na(.data[[m$col]])),
median = median(.data[[m$col]], na.rm = TRUE),
mean = mean(.data[[m$col]], na.rm = TRUE),
sd = sd(.data[[m$col]], na.rm = TRUE),
.groups = "drop"
) %>%
mutate(metric = m$col)
violin_stats[[m$col]] <- summary_df
}
# write combined violin summary stats
write_tsv(bind_rows(violin_stats), paste0(save_path, "satmut_prom_violin_summary_stats.txt"))
emvar_metrics <- list(
list(col = "avgKHS_emVar_neg_prom", label = "Number of negative emVars"),
list(col = "avgKHS_emVar_pos_prom", label = "Number of positive emVars")
)
for (m in emvar_metrics) {
df_plot <- satmut_promoters_pred_final_prom_level_real %>%
filter(!is.na(sig_pos_0.999_neg_0.001)) %>%
mutate(sig_class = factor(sig_labels[sig_pos_0.999_neg_0.001],
levels = names(sig_palette)))
p <- ggviolin(
df_plot,
x = "sig_class", y = m$col,
fill = "sig_class",
palette = sig_palette,
draw_quantiles = c(0.5)
) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.15))) +
geom_pwc(method = "wilcox_test", p.adjust.method = "BH",
label = "p.adj.format", hide.ns = TRUE, bracket.nudge.y = 0.15) +
theme(
axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
axis.line.x = element_blank(),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
panel.grid.major.y = element_line(color = "grey90"),
panel.grid.minor.y = element_blank(),
axis.line.y = element_blank(),
aspect.ratio = 1.6
) +
labs(y = m$label, x = "", fill = "")
print(p)
ggsave(paste0(save_path, "satmut_prom_violin_", m$col, ".pdf"), scale = 0.9, device = cairo_pdf)
}
cell_lines <- list(
list(x = "logTPM_K562",  y = "K562_activity_prom",  label = "K562",  color = "#47928B"),
list(x = "logTPM_HepG2", y = "HepG2_activity_prom", label = "HepG2", color = "#DBAE65"),
list(x = "logTPM_SKNSH", y = "SKNSH_activity_prom", label = "SK-N-SH", color = "#C44543")
)
df <- satmut_promoters_pred_final_prom_level_real
# compute shared axis limits
x_range <- range(c(df$logTPM_K562, df$logTPM_HepG2, df$logTPM_SKNSH), na.rm = TRUE)
y_range <- range(c(df$K562_activity_prom, df$HepG2_activity_prom, df$SKNSH_activity_prom), na.rm = TRUE)
expr_stats <- list()
for (cl in cell_lines) {
df_tmp <- df
# compute exact spearman rho and p-value
x <- df_tmp[[cl$x]]
y <- df_tmp[[cl$y]]
complete <- complete.cases(x, y)
x <- x[complete]
y <- y[complete]
n <- length(x)
rho <- cor(x, y, method = "spearman")
t_stat <- rho * sqrt((n - 2) / (1 - rho^2))
log_p <- log(2) + pt(abs(t_stat), df = n - 2, lower.tail = FALSE, log.p = TRUE)
p_val <- exp(log_p)
if (p_val < 1e-300) {
cor_label <- sprintf("rho == %.3f ~~ ',' ~~ italic(p) < 10^{-300}", rho)
} else {
cor_label <- sprintf("rho == %.3f ~~ ',' ~~ italic(p) == %.2e", rho, p_val)
}
message(sprintf("%s: rho = %.4f, n = %d, p = %s", cl$label, rho, n,
ifelse(p_val < 1e-300, sprintf("< 10^%.0f", ceiling(log_p / log(10))), sprintf("%.4e", p_val))))
expr_stats[[cl$label]] <- tibble(
cell_line = cl$label, comparison = "activity_vs_expression",
rho = rho, n = n, log10_p = log_p / log(10)
)
ggscatter(df_tmp,
x = cl$x, y = cl$y,
alpha = 0.1, color = cl$color
) +
xlab(bquote(.(cl$label) ~ "gene expression," ~ log[2](TPM + 1))) +
ylab(paste0(cl$label, " predicted CRE activity")) +
xlim(x_range) +
ylim(y_range) +
theme(
panel.grid.major.x = element_line(color = "grey90"),
panel.grid.major.y = element_line(color = "grey90"),
aspect.ratio = 1
) +
annotate("text", x = Inf, y = Inf, label = cor_label,
parse = TRUE, hjust = 1.05, vjust = 1.5, size = 3.5)
print(last_plot())
ggsave(paste0(save_path, "satmut_prom_expr_vs_activity_", cl$label, ".png"), scale = 0.7)
}
write_tsv(bind_rows(expr_stats), paste0(save_path, "satmut_prom_expr_vs_activity_stats.txt"))
cell_lines <- list(
list(x = "logTPM_K562",  y_suffix = "K562",  label = "K562",  color = "#47928B"),
list(x = "logTPM_HepG2", y_suffix = "HepG2", label = "HepG2", color = "#DBAE65"),
list(x = "logTPM_SKNSH", y_suffix = "SKNSH", label = "SK-N-SH", color = "#C44543")
)
assays <- list(
list(prefix = "DNase",   label = "DNase"),
list(prefix = "H3K27ac", label = "H3K27ac"),
list(prefix = "H3K4me3", label = "H3K4me3")
)
df <- satmut_promoters_pred_final_prom_level_real
# precompute log2(signal + 1) columns
for (assay in assays) {
for (cl in cell_lines) {
raw_col <- paste0(assay$prefix, "_", cl$y_suffix, "_250bp")
log_col <- paste0("log_", assay$prefix, "_", cl$y_suffix, "_250bp")
df[[log_col]] <- log2(df[[raw_col]] + 1)
}
}
# shared x-axis limits (gene expression)
x_range <- range(c(df$logTPM_K562, df$logTPM_HepG2, df$logTPM_SKNSH), na.rm = TRUE)
epigenome_stats <- list()
for (assay in assays) {
# shared y-axis limits per assay across cell lines
y_cols <- paste0("log_", assay$prefix, "_", sapply(cell_lines, `[[`, "y_suffix"), "_250bp")
y_range <- range(sapply(y_cols, function(col) range(df[[col]], na.rm = TRUE)))
for (cl in cell_lines) {
y_col <- paste0("log_", assay$prefix, "_", cl$y_suffix, "_250bp")
df_tmp <- df
# compute exact spearman rho and p-value
x <- df_tmp[[cl$x]]
y <- df_tmp[[y_col]]
complete <- complete.cases(x, y)
x <- x[complete]
y <- y[complete]
n <- length(x)
rho <- cor(x, y, method = "spearman")
t_stat <- rho * sqrt((n - 2) / (1 - rho^2))
log_p <- log(2) + pt(abs(t_stat), df = n - 2, lower.tail = FALSE, log.p = TRUE)
p_val <- exp(log_p)
if (p_val < 1e-300) {
cor_label <- sprintf("rho == %.3f ~~ ',' ~~ italic(p) < 10^{-300}", rho)
} else {
cor_label <- sprintf("rho == %.3f ~~ ',' ~~ italic(p) == %.2e", rho, p_val)
}
message(sprintf("%s %s: rho = %.4f, n = %d, p = %s", cl$label, assay$label, rho, n,
ifelse(p_val < 1e-300, "< 10^-300", sprintf("%.4e", p_val))))
epigenome_stats[[paste0(cl$label, "_", assay$prefix)]] <- tibble(
cell_line = cl$label, assay = assay$label,
rho = rho, n = n, log10_p = log_p / log(10)
)
ggscatter(df_tmp,
x = cl$x, y = y_col,
alpha = 0.1, color = cl$color
) +
xlab(bquote(.(cl$label) ~ "gene expression," ~ log[2](TPM + 1))) +
ylab(bquote(.(cl$label) ~ .(assay$label) ~ "," ~ log[2](signal + 1))) +
xlim(x_range) +
ylim(y_range) +
theme(
panel.grid.major.x = element_line(color = "grey90"),
panel.grid.major.y = element_line(color = "grey90"),
aspect.ratio = 1
) +
annotate("text", x = Inf, y = Inf, label = cor_label,
parse = TRUE, hjust = 1.05, vjust = 1.5, size = 3.5)
print(last_plot())
ggsave(paste0(save_path, "satmut_prom_expr_vs_", assay$prefix, "_", cl$label, "_250bp.png"), scale = 0.7)
}
}
write_tsv(bind_rows(epigenome_stats), paste0(save_path, "satmut_prom_expr_vs_epigenome_stats.txt"))
satmut_promoters_pred_final_prom_level_real
names(satmut_promoters_pred_final_prom_level_real)
